# Pi Dashboard MCP Server 反代规则
# 需要合并到 /etc/nftables-astrbot-proxy.conf 中

# tailscale0 入口
iifname "tailscale0" ip daddr 100.118.236.1 tcp dport 18473 dnat to 127.0.0.1:18473

# eth0 局域网入口
iifname "eth0" ip daddr 192.168.137.10 tcp dport 18473 dnat to 127.0.0.1:18473

# output 链（本机通过 Tailscale IP / 局域网 IP 自访问）
ip daddr 100.118.236.1 tcp dport 18473 dnat to 127.0.0.1:18473
ip daddr 192.168.137.10 tcp dport 18473 dnat to 127.0.0.1:18473
